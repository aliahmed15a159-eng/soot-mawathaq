# ============================================================
# صوت موثّق — ملف الإعدادات (انسخه إلى .env واملأ القيم)
# ============================================================

# (١) Supabase — من لوحة المشروع: Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # مفتاح service_role (سيرفر فقط — لا يُنشر في الواجهة)
# SUPABASE_ANON_KEY=eyJhbGciOi...              # بديل محدود لو مش هتستخدم service_role

# (٢) أمان الجلسات والتجزئة — ولّد قيمًا عشوائية طويلة في الإنتاج
SESSION_SECRET=change-me-to-a-long-random-string
IDENTITY_SALT=change-me-another-long-random-string
ADMIN_KEY=per-aa-admin

# (٣) سلوك المنصة
PORT=3000
REGISTER_MODE=open                # open = يقبل أي رقم قومي صحيح (تجربة) | strict = كشوف الناخبين فقط
TOKEN_TTL_MINUTES=15              # صلاحية رمز الاقتراع
SESSION_TTL_MINUTES=45            # صلاحية الجلسة
REVIEW_RETENTION_HOURS=24         # مدة الاحتفاظ بصور المراجعة قبل الحذف التلقائي

# عتبات قرار التحقق (0..1)
FACE_ACCEPT=0.72                  # أعلى من كده = مطابق
FACE_REVIEW=0.50                  # بين الاتنين = مراجعة بشرية
OCR_ACCEPT=0.62
QUALITY_ACCEPT=0.35

# (٤) للربط والتنفيذ عن بُعد عبر أدوات المشروع (اختياري — يُحذف/يُلغى بعد الانتهاء)
# توكن الإدارة من: supabase.com/dashboard/account/tokens  (يبدأ بـ sbp_)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# (٥) المرحلة ٢ — المزوّدون الحقيقيون (كل قسم اختياري، والمنصة تعمل بدونه)
VERIFY_PROVIDER=demo              # demo | facepp | rekognition | azure

# — مطابقة الوجه وكشف الحياة —
FACEPP_API_KEY=                   # faceplusplus.com  (منطقة: us افتراضيًا — FACEPP_REGION=cn|sg لتغييرها)
FACEPP_API_SECRET=
AWS_ACCESS_KEY_ID=                # AWS Rekognition
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AZURE_FACE_KEY=                   # Azure AI Face
AZURE_FACE_ENDPOINT=https://xxxx.cognitiveservices.azure.com

# — قراءة بطاقة الرقم القومي (OCR) —
OCR_PROVIDER=                     # اتركه فارغًا للاختيار التلقائي حسب المفتاح الموجود
OCRSPACE_KEY=                     # مفتاح مجاني من ocr.space
OCRSPACE_LANG=ara
GOOGLE_VISION_KEY=                # Google Cloud Vision
AZURE_VISION_KEY=                 # Azure Computer Vision (Read)
AZURE_VISION_ENDPOINT=

# — كود التحقق على الموبايل (OTP) —
OTP_MODE=off                      # off | console (يظهر في السجل) | sms (إرسال حقيقي)
OTP_DEBUG=0                       # 1 = إظهار الكود في استجابة الخادم للاختبار الآلي
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=SootMawathaq
SMSMISR_USERNAME=                 # مزوّد مصري
SMSMISR_PASSWORD=
SMSMISR_SENDER=
SMSMISR_LANG=2
